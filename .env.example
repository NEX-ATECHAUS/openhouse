# Copy to .env.local for local development. Real values live in the Vercel
# dashboard per environment, never in the repo. Never move a secret to a
# NEXT_PUBLIC_ prefix.

# --- Demo mode ---
# "true" serves sample listings and stubs every outside call (Domain, the
# geocoder, the router), so the app runs free and offline. Set it to
# "false" once the Domain keys below are in place.
NEXT_PUBLIC_DEMO_MODE=true

# --- Domain (the listings source) ---
# From developer.domain.com.au: create a project, add the "Agents &
# Listings" package, then create either an API key or an OAuth client.
# Either works; when both are set the API key is used. Server only.
DOMAIN_API_KEY=
DOMAIN_CLIENT_ID=
DOMAIN_CLIENT_SECRET=

# --- Travel times ---
# "estimate" (the default) works out drive times from straight-line
# distance. "osrm" asks an OSRM server for real road times and falls back
# to the estimate when it does not answer.
TRAVEL_PROVIDER=estimate
# The OSRM server to ask. The public demo server is for light personal
# use only (one request a second, no uptime promise).
OSRM_BASE_URL=https://router.project-osrm.org

# --- Geocoding (finding an address you add by hand) ---
# "nominatim" uses OpenStreetMap's Nominatim; "off" uses the suburb
# centre only. Nominatim's policy asks for a contact in the User-Agent.
GEOCODER=nominatim
GEOCODER_CONTACT=
